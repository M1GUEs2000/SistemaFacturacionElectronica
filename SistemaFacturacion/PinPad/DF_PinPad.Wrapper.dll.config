<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <!-- Ajusta el servidor/instancia y la base de datos según tu entorno -->
    <add name="PinPadLogsDb"
         connectionString="Server=localhost;Database=PinPadLogs;Trusted_Connection=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Valores tomados de ConfigFile.txt (configuración real verificada por el usuario) -->
    <add key="PinPad.IP" value="192.168.1.3" />
    <add key="PinPad.Puerto" value="9999" />
    <add key="PinPad.TimeOutMs" value="90000" />
    <add key="PinPad.MID" value="1791310199" />
    <add key="PinPad.TID" value="NP281374" />
    <add key="PinPad.CajaID" value="00000001" />

    <!-- DF_PinPad.ELANVersion: 0=V4_2, 1=V4_4, 2=VFastTrack -->
    <add key="PinPad.Version" value="2" />

    <!-- DF_PinPad.ESHA: 0=NoSha, 1=SHA1, 2=SHA2 -->
    <add key="PinPad.SHA" value="2" />
  </appSettings>
</configuration>
