        <DF_PinPad.Settings1>
            <setting name="GrabaLog" serializeAs="String">
                <value>1</value>
            </setting>
        </DF_PinPad.Settings1>
    </applicationSettings>-->
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/></startup></configuration>
