<?xml version="1.0" encoding="utf-8"?>
<!--
  rptBaucherDiferido.rdlc — Baucher de consumo con tarjeta DIFERIDO (Datafast).

  Gemelo de rptBaucher.rdlc (corriente). Se usa el mismo juego de parámetros MÁS
  los del diferido, y BaucherTarjeta.Imprimir(...) elige uno u otro .rdlc según
  el cobro haya sido corriente o diferido.

  Son dos archivos y no uno con visibilidad condicional porque el cuerpo del
  reporte posiciona TODO en absoluto (Top/Left): ocultar un Textbox dejaría el
  hueco igual y el resto de la tira no subiría. Aquí las filas extra corren la
  hoja de firma 1.20 cm hacia abajo.

  Diferencias contra el corriente:
    - Fila DIF <TIPO> / MESES: NN / GRACIA: NN  (entre FECHA-HORA y APROBACION)
    - Fila INTERES     (hoy siempre 0.00 — el POS todavía no calcula intereses)
    - Fila GRAN TOTAL  (VR. TOTAL + INTERES)

  Ancho pensado para el mismo rollo térmico que rptRecibo.rdlc (7 cm / 4 in).
-->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <!-- ============================================================= -->
      <!-- MARCO DEL CUPÓN DE CONSUMO                                    -->
      <!-- 1.20cm más alto que el corriente: 3 filas nuevas.             -->
      <!-- ============================================================= -->
      <Line Name="MarcoTop">
        <Top>0.05cm</Top>
        <Left>0.10cm</Left>
        <Height>0cm</Height>
        <Width>6.60cm</Width>
        <ZIndex>0</ZIndex>
        <Style>
          <Border>
            <Style>Solid</Style>
          </Border>
        </Style>
      </Line>
      <Line Name="MarcoBottom">
        <Top>9.25cm</Top>
        <Left>0.10cm</Left>
        <Height>0cm</Height>
        <Width>6.60cm</Width>
        <ZIndex>0</ZIndex>
        <Style>
          <Border>
            <Style>Solid</Style>
          </Border>
        </Style>
      </Line>
      <Line Name="MarcoLeft">
        <Top>0.05cm</Top>
        <Left>0.10cm</Left>
        <Height>9.20cm</Height>
        <Width>0cm</Width>
        <ZIndex>0</ZIndex>
        <Style>
          <Border>
            <Style>Solid</Style>
          </Border>
        </Style>
      </Line>
      <Line Name="MarcoRight">
        <Top>0.05cm</Top>
        <Left>6.70cm</Left>
        <Height>9.20cm</Height>
        <Width>0cm</Width>
        <ZIndex>0</ZIndex>
        <Style>
          <Border>
            <Style>Solid</Style>
          </Border>
        </Style>
      </Line>

      <!-- ============================================================= -->
      <!-- CABECERA DEL COMERCIO (EmpresaManejador)                       -->
      <!-- ============================================================= -->
      <Textbox Name="Comercio">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=Parameters!COMERCIO.Value</Value>
                <Style>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Comercio</rd:DefaultName>
        <Top>0.15cm</Top>
        <Left>0.20cm</Left>
        <Height>0.45cm</Height>
        <Width>6.40cm</Width>
        <ZIndex>1</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
      </Textbox>
      <Textbox Name="Ruc">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="R U C : " &amp; Parameters!RUC.Value</Value>
                <Style>
                  <FontSize>8pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Ruc</rd:DefaultName>
        <Top>0.60cm</Top>
        <Left>0.20cm</Left>
        <Height>0.40cm</Height>
        <Width>6.40cm</Width>
        <ZIndex>2</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
      </Textbox>
      <Textbox Name="Direccion">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=Parameters!DIRECCION.Value</Value>
                <Style>
                  <FontSize>8pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Direccion</rd:DefaultName>
        <Top>1.00cm</Top>
        <Left>0.20cm</Left>
        <Height>0.40cm</Height>
        <Width>6.40cm</Width>
        <ZIndex>3</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
      </Textbox>
      <Textbox Name="Telefono">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="Telefono " &amp; Parameters!TELEFONO.Value</Value>
                <Style>
                  <FontSize>8pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Telefono</rd:DefaultName>
        <Top>1.40cm</Top>
        <Left>0.20cm</Left>
        <Height>0.40cm</Height>
        <Width>6.40cm</Width>
        <ZIndex>4</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
      </Textbox>
      <!-- CIUDAD: queda vacía a propósito — no existe el campo en la tabla EMPRESA. -->
      <Textbox Name="Ciudad">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=Parameters!CIUDAD.Value</Value>
                <Style>
                  <FontSize>8pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Ciudad</rd:DefaultName>
        <Top>1.80cm</Top>
        <Left>0.20cm</Left>
        <Height>0.40cm</Height>
        <Width>6.40cm</Width>
        <ZIndex>5</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
      </Textbox>
      <!-- TID - MID - versión de aplicación (quemada) - modo de lectura (MODOPAGO). -->
      <Textbox Name="Terminal">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=Parameters!TID.Value &amp; " - " &amp; Parameters!MID.Value &amp; " - 4.0.01 - "</Value>
                <Style>
                  <FontSize>7pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!MODOLECTURA.Value</Value>
                <Style>
                  <FontSize>7pt</FontSize>
                  <Color>Black</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Terminal</rd:DefaultName>
        <Top>2.20cm</Top>
        <Left>0.20cm</Left>
        <Height>0.40cm</Height>
        <Width>6.40cm</Width>
        <ZIndex>6</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
      </Textbox>
      <Textbox Name="GrupoTarjeta">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=Parameters!GRUPOTARJETA.Value</Value>
                <Style>
                  <FontSize>8pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>GrupoTarjeta</rd:DefaultName>
        <Top>2.60cm</Top>
        <Left>0.20cm</Left>
        <Height>0.45cm</Height>
        <Width>6.40cm</Width>
        <ZIndex>7</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
      </Textbox>

      <!-- ============================================================= -->
      <!-- DATOS DE LA TRANSACCIÓN (ProcesoPagoResult)                    -->
      <!-- ============================================================= -->
      <Textbox Name="Tarjeta">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="TARJETA: " &amp; Parameters!TARJETA.Value</Value>
                <Style>
                  <FontSize>7pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Tarjeta</rd:DefaultName>
        <Top>3.20cm</Top>
        <Left>0.30cm</Left>
        <Height>0.40cm</Height>
        <Width>4.10cm</Width>
        <ZIndex>8</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
      </Textbox>
      <Textbox Name="Vencimiento">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="V:" &amp; Parameters!VENCIMIENTO.Value</Value>
                <Style>
                  <FontSize>7pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Vencimiento</rd:DefaultName>
        <Top>3.20cm</Top>
        <Left>4.45cm</Left>
        <Height>0.40cm</Height>
        <Width>2.15cm</Width>
        <ZIndex>9</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
      </Textbox>
      <Textbox Name="Lote">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="LOTE#: " &amp; Parameters!LOTE.Value</Value>
                <Style>
                  <FontSize>7pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Lote</rd:DefaultName>
        <Top>3.60cm</Top>
        <Left>0.30cm</Left>
        <Height>0.40cm</Height>
        <Width>4.10cm</Width>
        <ZIndex>10</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
      </Textbox>
      <Textbox Name="Referencia">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="REF: " &amp; Parameters!REFERENCIA.Value</Value>
                <Style>
                  <FontSize>7pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Referencia</rd:DefaultName>
        <Top>3.60cm</Top>
        <Left>4.45cm</Left>
        <Height>0.40cm</Height>
        <Width>2.15cm</Width>
        <ZIndex>11</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
      </Textbox>
      <Textbox Name="LblAdquirente">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>ADQUIRIENTE:</Value>
                <Style>
                  <FontSize>7pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>LblAdquirente</rd:DefaultName>
        <Top>4.00cm</Top>
        <Left>0.30cm</Left>
        <Height>0.40cm</Height>
        <Width>4.10cm</Width>
        <ZIndex>12</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
      </Textbox>
      <Textbox Name="Adquirente">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=Parameters!ADQUIRIENTE.Value</Value>
                <Style>
                  <FontSize>7pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Adquirente</rd:DefaultName>
        <Top>4.00cm</Top>
        <Left>4.45cm</Left>
        <Height>0.40cm</Height>
        <Width>2.15cm</Width>
        <ZIndex>13</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
      </Textbox>
      <Textbox Name="Fecha">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="FECHA:" &amp; Parameters!FECHA.Value</Value>
                <Style>
                  <FontSize>7pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Fecha</rd:DefaultName>
        <Top>4.40cm</Top>
        <Left>0.30cm</Left>
        <Height>0.40cm</Height>
        <Width>4.10cm</Width>
        <ZIndex>14</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
      </Textbox>
      <Textbox Name="Hora">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="HORA: " &amp; Parameters!HORA.Value</Value>
                <Style>
                  <FontSize>7pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Hora</rd:DefaultName>
        <Top>4.40cm</Top>
        <Left>4.45cm</Left>
        <Height>0.40cm</Height>
        <Width>2.15cm</Width>
        <ZIndex>15</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
      </Textbox>

      <!-- ============================================================= -->
      <!-- FILA DEL DIFERIDO — lo único que el corriente no imprime.      -->
      <!--                                                                -->
      <!--   DIF <TIPO>        MESES: NN        GRACIA: NN                -->
      <!--                                                                -->
      <!-- TIPODIFERIDO es el VALOR de PARAMETROS_TRANSACCIONES           -->
      <!-- (NOMBRE='TIPODIFERIDO'), ya escogido en el popup de tarjeta.   -->
      <!-- MESES es el plazo en cuotas que se le mandó al pinpad.         -->
      <!-- GRACIA sale en blanco en los diferidos que no la usan.         -->
      <!-- ============================================================= -->
      <Textbox Name="DifTipo">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="DIF " &amp; Parameters!TIPODIFERIDO.Value</Value>
                <Style>
                  <FontSize>7pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>DifTipo</rd:DefaultName>
        <Top>4.80cm</Top>
        <Left>0.30cm</Left>
        <Height>0.40cm</Height>
        <Width>3.10cm</Width>
        <ZIndex>16</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>0pt</PaddingRight>
        </Style>
      </Textbox>
      <Textbox Name="DifMeses">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=IIf(Trim(Parameters!CUOTAS.Value) = "", "", "MESES: " &amp; Parameters!CUOTAS.Value)</Value>
                <Style>
                  <FontSize>7pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>DifMeses</rd:DefaultName>
        <Top>4.80cm</Top>
        <Left>3.40cm</Left>
        <Height>0.40cm</Height>
        <Width>1.60cm</Width>
        <ZIndex>17</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>0pt</PaddingLeft>
          <PaddingRight>0pt</PaddingRight>
        </Style>
      </Textbox>
      <Textbox Name="DifGracia">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=IIf(Trim(Parameters!GRACIA.Value) = "", "", "GRACIA: " &amp; Parameters!GRACIA.Value)</Value>
                <Style>
                  <FontSize>7pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Right</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>DifGracia</rd:DefaultName>
        <Top>4.80cm</Top>
        <Left>5.00cm</Left>
        <Height>0.40cm</Height>
        <Width>1.60cm</Width>
        <ZIndex>18</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>0pt</PaddingLeft>
          <PaddingRight>4pt</PaddingRight>
        </Style>
      </Textbox>

      <Textbox Name="Aprobacion">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="APROBACION#     " &amp; Parameters!APROBACION.Value</Value>
                <Style>
                  <FontSize>8pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Aprobacion</rd:DefaultName>
        <Top>5.35cm</Top>
        <Left>0.30cm</Left>
        <Height>0.45cm</Height>
        <Width>6.30cm</Width>
        <ZIndex>19</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
      </Textbox>

      <!-- ============================================================= -->
      <!-- MONTOS — mismos que se cobraron en el pinpad (TotalesFactura). -->
      <!-- La tarifa del rótulo viene de PARAMETROS_FACTURAS, no es fija. -->
      <!-- ============================================================= -->
      <Textbox Name="LblBaseGravada">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="BASE CONSUMO TARIFA " &amp; Parameters!TARIFAIVA.Value</Value>
                <Style>
                  <FontSize>7pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>LblBaseGravada</rd:DefaultName>
        <Top>5.90cm</Top>
        <Left>0.30cm</Left>
        <Height>0.38cm</Height>
        <Width>3.30cm</Width>
        <ZIndex>20</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>0pt</PaddingRight>
        </Style>
      </Textbox>
      <Textbox Name="UsdBaseGravada">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>:US$</Value>
                <Style>
                  <FontSize>7pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>UsdBaseGravada</rd:DefaultName>
        <Top>5.90cm</Top>
        <Left>3.65cm</Left>
        <Height>0.38cm</Height>
        <Width>1.05cm</Width>
        <ZIndex>21</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>0pt</PaddingLeft>
          <PaddingRight>0pt</PaddingRight>
        </Style>
      </Textbox>
      <Textbox Name="BaseGravada">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=Parameters!BASEGRAVADA.Value</Value>
                <Style>
                  <FontSize>7pt</FontSize>
                </Style>
              </TextRun>
