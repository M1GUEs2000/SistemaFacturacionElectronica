<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
    </configSections>
    <connectionStrings>
        <add name="SistemaFacturacion.Properties.Settings.ConexionDB" connectionString="Provider=Microsoft.ACE.OLEDB.12.0;Data Source=C:\BDFacturacion.accdb" providerName="System.Data.OleDb" />
    </connectionStrings>
    <appSettings>
        <!-- PinPad Datafast. La auditoría NO va a SQL Server: se registra en Access
             (mismas tablas PINPAD_* de la .accdb) via PinPadLogManejador, por eso
             NO se define ninguna connection string 'PinPadLogsDb'.

             IMPORTANTE (guía oficial, secciones 3 y 7.3):
               - PinPad.IP     = IP LOCAL del pinpad FÍSICO en la LAN (NO la IP
                                 transaccional 200.0.67.188 — esa es el host de Datafast
                                 que se configura DENTRO del dispositivo, no aquí).
               - PinPad.Puerto = "Puerto Escucha" de comunicación caja<->equipo (9999).
             La "Clave técnica" 166831 se usa en la INICIALIZACIÓN del terminal
             (proceso del proveedor), no interviene en ProcesarPago. -->
        <add key="PinPad.IP" value="192.168.1.9" /> <!-- TODO: IP local real del pinpad en la LAN -->
        <add key="PinPad.Puerto" value="9999" />    <!-- Puerto Escucha -->
        <add key="PinPad.TimeOutMs" value="90000" />
        <add key="PinPad.MID" value="1791310199" />
        <add key="PinPad.TID" value="NP501183" />
        <add key="PinPad.CajaID" value="00000001" />
        <add key="PinPad.Version" value="2" /> <!-- 0=V4_2  1=V4_4  2=VFastTrack (guía usa 2) -->
        <add key="PinPad.SHA" value="2" />     <!-- 0=NoSha 1=SHA1  2=SHA2 (guía usa 2) -->
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.IdentityModel.Abstractions" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.14.0.0" newVersion="8.14.0.0" />
