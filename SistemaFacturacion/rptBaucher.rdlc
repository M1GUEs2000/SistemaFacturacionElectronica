            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Comercio</rd:DefaultName>
        <Top>0.15cm</Top>
        <Left>0.20cm</Left>
        <Height>0.45cm</Height>
        <Width>6.40cm</Width>
