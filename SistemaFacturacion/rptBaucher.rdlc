<?xml version="1.0" encoding="utf-8"?>
<!--
  rptBaucher.rdlc — Baucher de consumo con tarjeta (Datafast).

  Se imprime SOLO cuando el cobro fue con tarjeta Y el total alcanza el parámetro
  MINIMOFIRMA (PARAMETROS_TRANSACCIONES, CODIGO='F1'). Sale como una SEGUNDA tira,
  después del recibo: el recibo se sigue imprimiendo en toda venta, sin cambios.

  Todo entra por ReportParameters (no hay DataSets): son campos escalares y así se
  evita un Tablix por dato. Los arma BaucherTarjeta.Imprimir(...).

  El rótulo final (ORIGINAL / COPIA) es el parámetro ROTULO — para la reimpresión
  de la copia solo hay que llamar otra vez con "COPIA", sin tocar este archivo.

  Ancho pensado para el mismo rollo térmico que rptRecibo.rdlc (7 cm / 4 in).
-->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <!-- ============================================================= -->
      <!-- MARCO DEL CUPÓN DE CONSUMO                                    -->
      <!-- ============================================================= -->
      <Line Name="MarcoTop">
        <Top>0.05cm</Top>
        <Left>0.10cm</Left>
        <Height>0cm</Height>
        <Width>6.60cm</Width>
        <ZIndex>0</ZIndex>
        <Style>
          <Border>
            <Style>Solid</Style>
          </Border>
        </Style>
      </Line>
      <Line Name="MarcoBottom">
        <Top>8.05cm</Top>
        <Left>0.10cm</Left>
        <Height>0cm</Height>
        <Width>6.60cm</Width>
        <ZIndex>0</ZIndex>
        <Style>
          <Border>
            <Style>Solid</Style>
          </Border>
        </Style>
      </Line>
      <Line Name="MarcoLeft">
        <Top>0.05cm</Top>
        <Left>0.10cm</Left>
        <Height>8.00cm</Height>
        <Width>0cm</Width>
        <ZIndex>0</ZIndex>
        <Style>
          <Border>
            <Style>Solid</Style>
          </Border>
        </Style>
      </Line>
      <Line Name="MarcoRight">
        <Top>0.05cm</Top>
        <Left>6.70cm</Left>
        <Height>8.00cm</Height>
        <Width>0cm</Width>
        <ZIndex>0</ZIndex>
        <Style>
          <Border>
            <Style>Solid</Style>
          </Border>
        </Style>
      </Line>

